# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# ใช้เฉพาะฝั่ง server: seed, cron, notification ห้ามใส่ NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# รหัสผ่านผู้ใช้ทดสอบตอนรัน npm run seed
SEED_USER_PASSWORD=S2000test!

# LINE Messaging API (เฟส 2 ถ้าไม่ใส่ ระบบจะ log แทน)
LINE_MESSAGING_TOKEN=

# กันไม่ให้คนนอกเรียก cron
CRON_SECRET=change-me
