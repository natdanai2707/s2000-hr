# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# ใช้เฉพาะฝั่ง server: seed, cron, notification ห้ามใส่ NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ให้ Claude อ่านโครงไฟล์ BOQ ตอนนำเข้า (ไม่ใส่ก็ยังนำเข้าได้ แต่จะเดาคอลัมน์จากชื่อหัวตารางแทน)
# สร้างคีย์ที่ https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# รหัสผ่านผู้ใช้ทดสอบตอนรัน npm run seed
SEED_USER_PASSWORD=S2000test!

# LINE Messaging API (เฟส 2 ถ้าไม่ใส่ ระบบจะ log แทน)
LINE_MESSAGING_TOKEN=

# กันไม่ให้คนนอกเรียก cron
CRON_SECRET=change-me
